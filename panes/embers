#!/usr/bin/env python3
"""embers: a small bonfire for a terminal pane, with flames and rising sparks.

  embers            flames and sparks
  embers --fps 8    lower the frame rate (default 12)
"""
import argparse
import os
import random
import shutil
import sys
import time

try:
    import termios
except ImportError:  # not a Unix terminal
    termios = None

# (heat, color): black through red and ember to a white-hot core.
STOPS = [
    (0.00, (9, 9, 9)),
    (0.12, (58, 14, 6)),
    (0.28, (150, 30, 4)),
    (0.46, (254, 69, 0)),
    (0.66, (254, 135, 0)),
    (0.84, (255, 214, 2)),
    (1.00, (255, 244, 214)),
]
LEVELS = 28
SPARK_GLYPHS = "'`.*"


def color_at(heat):
    for (h0, c0), (h1, c1) in zip(STOPS, STOPS[1:]):
        if heat <= h1:
            t = (heat - h0) / (h1 - h0)
            return tuple(round(a + (b - a) * t) for a, b in zip(c0, c1))
    return STOPS[-1][1]


PALETTE = [color_at(i / (LEVELS - 1)) for i in range(LEVELS)]


class Fire:
    """The simulation, kept apart from the drawing so it can be tested.

    Each terminal cell holds two heat pixels, stacked, so flames look
    smoother than the character grid would allow.
    """

    def __init__(self, width, height, rng=None):
        self.w, self.h = width, height * 2
        self.rows = height
        self.rng = rng or random.Random()
        self.heat = [[0.0] * width for _ in range(self.h)]
        self.sparks = []  # [x, pixel y, rise speed, drift, life]
        self.cooling = 2.6 / self.h  # flames reach about two thirds of the way up

    def _fuel(self, x):
        """The bed of the fire: hottest in the middle, weak at the edges."""
        middle = (self.w - 1) / 2 or 1
        distance = abs(x - middle) / middle
        return max(0.0, 1.0 - distance ** 2.4 * 0.75)

    def step(self):
        rng, w, h, heat = self.rng, self.w, self.h, self.heat
        for x in range(w):
            heat[h - 1][x] = self._fuel(x) * rng.uniform(0.72, 1.0)
        for y in range(h - 2, -1, -1):
            below, under = heat[y + 1], heat[min(h - 1, y + 2)]
            row = heat[y]
            for x in range(w):
                spread = x + rng.choice((-1, 0, 0, 1))
                spread = min(w - 1, max(0, spread))
                value = (below[spread] * 2 + below[x] + under[x]) / 4
                value -= rng.uniform(0.0, self.cooling * 2)
                row[x] = value if value > 0.02 else 0.0

        wanted = max(3, w // 3)
        if len(self.sparks) < wanted and rng.random() < 0.55:
            x = rng.gauss((w - 1) / 2, w / 5)
            self.sparks.append([x, h * 0.72, rng.uniform(0.7, 1.7),
                                rng.uniform(-0.2, 0.2), rng.uniform(0.75, 1.0)])
        alive = []
        for spark in self.sparks:
            spark[0] += spark[3] + rng.uniform(-0.3, 0.3)
            spark[1] -= spark[2]
            spark[4] -= 0.035
            if spark[4] > 0.15 and spark[1] >= 0 and 0 <= spark[0] < w:
                alive.append(spark)
        self.sparks = alive

    def cells(self):
        """Yield (row, column, glyph, foreground level, background level)."""
        grid = {}
        for x, y, _, _, life in self.sparks:
            grid[(int(y) // 2, int(x))] = life
        last = LEVELS - 1
        for row in range(self.rows):
            top, bottom = self.heat[row * 2], self.heat[row * 2 + 1]
            for x in range(self.w):
                upper = min(last, int(top[x] * LEVELS))
                lower = min(last, int(bottom[x] * LEVELS))
                life = grid.get((row, x))
                if upper + lower == 0:
                    if life is None:
                        yield row, x, " ", 0, 0
                    else:
                        index = min(len(SPARK_GLYPHS) - 1, int(life * len(SPARK_GLYPHS)))
                        yield row, x, SPARK_GLYPHS[index], min(last, int((life + 0.2) * LEVELS)), 0
                else:
                    yield row, x, "▀", upper, lower  # upper half block


def size():
    try:
        s = os.get_terminal_size(sys.stdout.fileno())
        return s.columns, s.lines
    except OSError:
        return shutil.get_terminal_size()


def run(fps):
    out = sys.stdout
    fore = ["\x1b[38;2;%d;%d;%dm" % c for c in PALETTE]
    back = ["\x1b[48;2;%d;%d;%dm" % c for c in PALETTE]
    back[0] = "\x1b[49m"  # let the terminal background show through
    width, height = size()
    fire = Fire(width, height)
    shown = {}
    out.write("\x1b[?1049h\x1b[?25l\x1b[2J")
    delay = 1 / fps
    while True:
        started = time.monotonic()
        new_size = size()
        if new_size != (width, height):
            width, height = new_size
            fire = Fire(width, height)
            shown = {}
            out.write("\x1b[0m\x1b[2J")
        fire.step()
        parts, last_fg, last_bg = [], None, None
        for y, x, glyph, fg, bg in fire.cells():
            cell = (glyph, fg, bg)
            if shown.get((y, x), (" ", 0, 0)) == cell:
                continue
            shown[(y, x)] = cell
            parts.append("\x1b[%d;%dH" % (y + 1, x + 1))
            if fg != last_fg:
                parts.append(fore[fg])
                last_fg = fg
            if bg != last_bg:
                parts.append(back[bg])
                last_bg = bg
            parts.append(glyph)
        if parts:
            out.write("".join(parts) + "\x1b[0m")
            out.flush()
        time.sleep(max(0.0, delay - (time.monotonic() - started)))


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--fps", type=int, default=12, help="frames per second (default 12)")
    args = parser.parse_args()

    saved = None
    if termios and sys.stdin.isatty():  # stop keystrokes printing over the fire
        saved = termios.tcgetattr(sys.stdin)
        quiet = termios.tcgetattr(sys.stdin)
        quiet[3] &= ~(termios.ECHO | termios.ICANON)
        termios.tcsetattr(sys.stdin, termios.TCSANOW, quiet)
    try:
        run(max(1, args.fps))
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\x1b[0m\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        if saved:
            termios.tcsetattr(sys.stdin, termios.TCSANOW, saved)


if __name__ == "__main__":
    main()
